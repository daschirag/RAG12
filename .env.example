# Vector-store backend: local | azure
# local = free, no account needed, runs on your machine. azure = production mode, requires the AZURE_* keys below to be filled in.
BACKEND_MODE=local

# Local LLM via Ollama (used when BACKEND_MODE=local)
# llama3.2:3b is a faster fallback if generation feels slow.
OLLAMA_MODEL=qwen2.5:7b-instruct

# Model caches (HF_HOME / TORCH_HOME are forced under this root at startup)
GREENRAG_CACHE_DIR=D:\Rag\cache

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# Azure AI Search
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX=

# Azure Storage
AZURE_STORAGE_CONNECTION_STRING=

# Azure Cosmos DB
AZURE_COSMOS_ENDPOINT=
AZURE_COSMOS_KEY=
