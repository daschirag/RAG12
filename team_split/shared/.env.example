# Copy to .env (git-ignored) and fill in. Never put a key, token or connection string in a committed file.
# All variables are read by src/backend/settings.py; secrets by src/backend/cloud/secrets.py.

# Backend: local (default; FastAPI + ChromaDB + Ollama) | azure (plan A: AI Search, Blob, Key Vault, App Insights)
BACKEND_MODE=local

# Local LLM via Ollama (also used in azure mode under plan A)
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_HOST=http://127.0.0.1:11434

# Model caches (HF_HOME / TORCH_HOME are forced under this root at startup)
GREENRAG_CACHE_DIR=D:\Rag\cache

# ---- azure mode (plan A) - non-secret settings: endpoints and names only ----
# Providers: auto picks azure_openai only if the AZURE_OPENAI_* variables are set; plan A keeps both local.
EMBEDDING_PROVIDER=auto
GENERATOR_PROVIDER=auto
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_INDEX=greenrag
AZURE_KEY_VAULT_URL=
AZURE_STORAGE_ACCOUNT_URL=
AZURE_KB_CONTAINER=kbdocs
AZURE_RESULTS_CONTAINER=results
# local | blob (read documents.jsonl from the kb container; trust is still checked in-process)
KB_SOURCE=local
# true: send the request log to Application Insights
GREENRAG_APPINSIGHTS=false

# ---- secrets: leave EMPTY to read them from Key Vault (az login), or set them only in your local .env ----
# Key Vault secret search-admin-key
AZURE_SEARCH_API_KEY=
# Key Vault secret appinsights-connection-string
APPLICATIONINSIGHTS_CONNECTION_STRING=

# ---- optional, not used by plan A (Azure OpenAI) ----
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
